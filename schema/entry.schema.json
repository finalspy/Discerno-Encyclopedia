{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entry.schema.json",
  "title": "Encyclopedia entry front matter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "type",
    "lang",
    "title",
    "summary",
    "status"
  ],
  "properties": {
    "slug": {
      "description": "Stable identifier, equal to the file name without extension. Never reused.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "aliases": {
      "description": "Former slugs of this entry. A renamed entry keeps its old slug here so that existing links keep resolving.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "bias",
        "manipulation-technique",
        "fallacy",
        "rhetorical-device",
        "indicator",
        "concept"
      ]
    },
    "lang": {
      "type": "string",
      "enum": [
        "en",
        "fr"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "synonyms": {
      "description": "Other names under which the concept is known.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "description": "One sentence, plain text.",
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "status": {
      "description": "Review status. Only published entries are shown to users.",
      "type": "string",
      "enum": [
        "draft",
        "in-review",
        "published"
      ]
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "related": {
      "description": "Slugs of related entries.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "classifications": {
      "description": "Identifiers of the entry in external taxonomies.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disarm": {
          "$ref": "#/$defs/identifiers"
        },
        "semeval2023": {
          "$ref": "#/$defs/identifiers"
        },
        "semeval2020": {
          "$ref": "#/$defs/identifiers"
        },
        "logic": {
          "$ref": "#/$defs/identifiers"
        },
        "wikipedia": {
          "$ref": "#/$defs/identifiers"
        }
      }
    },
    "references": {
      "description": "Sources the entry relies on. Required once the entry is published.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "adapted_from": {
      "description": "Third-party works the text is adapted from. Their license must allow it (CC BY-SA or compatible).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url",
          "license"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "license": {
            "type": "string",
            "enum": [
              "CC-BY-SA-4.0",
              "CC-BY-SA-3.0",
              "CC-BY-4.0",
              "CC0-1.0"
            ]
          }
        }
      }
    },
    "themes": {
      "description": "Thematic sections the entry belongs to.",
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "cognitive-biases",
          "argumentation",
          "influence-and-persuasion",
          "obscurantism-and-pseudoscience",
          "authoritarian-drift",
          "statistics-and-data"
        ]
      }
    },
    "reviewed_by": {
      "description": "Name or role of the external reviewer. Required to publish an entry of the authoritarian-drift theme.",
      "type": "string",
      "minLength": 1
    },
    "open_issues": {
      "description": "Points still to fix or to settle on the entry. A published entry has none (checked by the validator).",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/open_issue"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "last_reviewed",
          "references"
        ],
        "properties": {
          "last_reviewed": true,
          "references": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "published"
          },
          "themes": {
            "type": "array",
            "contains": {
              "const": "authoritarian-drift"
            }
          }
        },
        "required": [
          "status",
          "themes"
        ]
      },
      "then": {
        "required": [
          "reviewed_by"
        ],
        "properties": {
          "reviewed_by": true
        }
      }
    }
  ],
  "$defs": {
    "open_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "note"
      ],
      "properties": {
        "kind": {
          "description": "source-missing: a claim has no reference. unverified: a reference or a summary was not checked against the work. link-missing: no stable link found. contested: sources disagree or the claim is disputed. neutrality: the wording or example may favor a side. uncertain: a question for the owner. other: anything else.",
          "type": "string",
          "enum": [
            "source-missing",
            "unverified",
            "link-missing",
            "contested",
            "neutrality",
            "uncertain",
            "other"
          ]
        },
        "note": {
          "description": "What is to fix or to settle, in one or two sentences.",
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "description": "Number of the tracker issue where the point is discussed.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "identifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "anyOf": [
        {
          "properties": {
            "url": true
          },
          "required": [
            "url"
          ]
        },
        {
          "properties": {
            "author": true,
            "year": true
          },
          "required": [
            "author",
            "year"
          ]
        }
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1500
        },
        "doi": {
          "description": "Digital Object Identifier of the work, without the resolver prefix.",
          "type": "string",
          "pattern": "^10\\.\\d{4,9}/\\S+$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "accessed": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
