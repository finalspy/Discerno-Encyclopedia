{
  "name": "@discerno/encyclopedia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Entries on cognitive biases, manipulation techniques, fallacies and rhetorical devices, with their schema and validator.",
  "license": "(CC-BY-SA-4.0 AND AGPL-3.0-only)",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./schema/entry.schema.json": "./schema/entry.schema.json",
    "./entries/*": "./entries/*"
